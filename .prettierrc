{
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "endOfLine": "lf",
    "printWidth": 150,
    "plugins":[
      "prettier-plugin-organize-attributes",
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ],
    "attributeGroups": ["$DEFAULT", "^data-"],
    "attributeSort": "ASC"
  }